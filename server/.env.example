# LLM provider: openai, anthropic, or ollama
LLM_PROVIDER=openai

# API key (not needed for ollama)
LLM_API_KEY=your-api-key-here

# Model name
# OpenAI examples: gpt-4o, gpt-4o-mini
# Anthropic examples: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Ollama examples: llama3.2, mistral, qwen2.5
LLM_MODEL=gpt-4o-mini  # comma-separated list = OpenRouter fallback chain

# Optional: override the base URL (useful for OpenRouter, Ollama, or custom endpoints)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:11434/v1

# Optional: OpenRouter telemetry headers
# OPENROUTER_REFERER=http://localhost
# OPENROUTER_TITLE=FunStory

# Server port and bind address
PORT=8765
HOST=0.0.0.0

# Rate limiting: applies only to traffic arriving via the public nginx proxy
# (localhost/LAN/VPN direct requests are always exempt)
RATE_LIMIT_PER_HOUR=20
# Optional: send header X-Funstory-Key to bypass the limit (testing/scripts)
# RATE_LIMIT_BYPASS_KEY=some-long-random-string
